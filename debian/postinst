#!/bin/sh
# postinst — Diwall .deb distribution channel.
# Mirrors scripts/install.sh's logic (user/group, venv, Chromium, permissions),
# adapted for dpkg's maintainer-script context. Requires network access
# (pip install, playwright install chromium) — documented in debian/control.
set -e

DEST="/opt/diwall"
GROUPE="diwall"

case "$1" in
    configure)
        if ! getent group "$GROUPE" >/dev/null; then
            addgroup --system "$GROUPE"
        fi
        if ! getent passwd "$GROUPE" >/dev/null; then
            adduser --system --no-create-home --home /nonexistent --shell /bin/false --ingroup "$GROUPE" "$GROUPE"
        fi

        chown root:"$GROUPE" "$DEST"
        chmod 755 "$DEST"
        chown -R root:"$GROUPE" "$DEST/lib" "$DEST/scenarios"
        chmod -R 755 "$DEST/lib" "$DEST/scenarios"
        chown root:"$GROUPE" "$DEST/scripts"
        chmod 755 "$DEST/scripts"
        chmod 755 "$DEST/scripts"/*.sh

        # watch.py invokes shot.py as a direct subprocess (relies on the
        # shebang + execute bit, not "python3 shot.py") — missing from the
        # initial packaging (dh_fixperms leaves regular files at 644),
        # caught by a real install/remove test on this cycle. The
        # git-clone channel's deploy.sh already sets this (line ~202).
        chmod 755 "$DEST/shot.py" "$DEST/watch.py" "$DEST/rpa.py" "$DEST/journal.py"

        if [ ! -f "$DEST/venv/bin/python3" ]; then
            echo "Diwall: creating Python virtual environment..."
            python3 -m venv "$DEST/venv"
            "$DEST/venv/bin/pip" install --quiet -r "$DEST/requirements.txt"
        fi

        if ! "$DEST/venv/bin/python3" -c \
            "from playwright.sync_api import sync_playwright; p = sync_playwright().start(); c = p.chromium.executable_path; p.stop(); import os,sys; sys.exit(0 if os.path.isfile(c) else 1)" \
            2>/dev/null; then
            echo "Diwall: installing Chromium via Playwright..."
            "$DEST/venv/bin/playwright" install chromium
        fi

        mkdir -p /var/log/diwall/preuves
        chown root:"$GROUPE" /var/log/diwall
        chmod 2770 /var/log/diwall
        chown root:"$GROUPE" /var/log/diwall/preuves
        chmod 2770 /var/log/diwall/preuves

        # watch.py writes reference PNGs here (--sauver-reference) — missing
        # in the initial packaging, caught by a real install/remove test on
        # v1.19.0 (git-clone channel's install.sh already creates this).
        mkdir -p "$DEST/references"
        chown root:"$GROUPE" "$DEST/references"
        chmod 770 "$DEST/references"

        mkdir -p /etc/diwall
        chown root:"$GROUPE" /etc/diwall
        chmod 755 /etc/diwall
        cat > /etc/diwall/diwall-sample.conf << 'CONF_EOF'
{
  "vault_dir": "~/Vaults/Diwall",
  "navigation": {
    "min_action_delay_ms": 800,
    "max_pages_par_run": 10,
    "max_actions_par_run": 30
  },
  "journal": {
    "chemin": "~/Vaults/Diwall/operations.jsonl"
  }
}
CONF_EOF
        chown root:"$GROUPE" /etc/diwall/diwall-sample.conf
        chmod 644 /etc/diwall/diwall-sample.conf
        # diwall.conf is never created automatically — manual configuration
        # required, matching the git-clone channel's own doctrine.
        if [ ! -f /etc/diwall/diwall.conf ]; then
            echo ""
            echo "=========================================================="
            echo " Diwall installed. No configuration active yet."
            echo " Create /etc/diwall/diwall.conf from the template:"
            echo "   sudo cp /etc/diwall/diwall-sample.conf /etc/diwall/diwall.conf"
            echo "   sudo nano /etc/diwall/diwall.conf"
            echo " Then add your operator account to the diwall group:"
            echo "   sudo usermod -aG diwall \$USER"
            echo "=========================================================="
            echo ""
        fi

        echo "Diwall installed. Check version: diwall-shot --version"
        ;;
esac

#DEBHELPER#

exit 0
